# ==============================================================================
# RESEND TRANSACTIONAL EMAIL CONFIGURATION
# ==============================================================================

# 1. Resend API Key (REQUIRED for direct website form delivery)
# Generate your API key at: https://resend.com/api-keys
# KEEP THIS SECRET: Never commit real keys or expose them client-side.
RESEND_API_KEY=re_your_api_key_here

# 2. Verified Sender Address (REQUIRED)
# For initial testing before domain verification:
# Resend provides a shared testing sender: onboarding@resend.dev
# (Note: onboarding@resend.dev can only deliver to the email registered with your Resend account, i.e. rj751054@gmail.com).
# For production with your own custom domain (e.g. rushikeshjoshi.dev):
# Verify your domain in https://resend.com/domains and set:
# RESEND_FROM_EMAIL=Rushikesh Joshi <contact@rushikeshjoshi.dev>
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# 3. Recipient Email Address (OPTIONAL, defaults to rj751054@gmail.com)
# All form messages are delivered to this address.
CONTACT_TO_EMAIL=rj751054@gmail.com
